# ---------------------------------------------------------------------------
# Copy to `.env` and edit. `.env` is git-ignored — never commit it.
#   cp .env.example .env
#
# server.py reads this file itself; the systemd unit also exports it.
# ---------------------------------------------------------------------------

# ---- Network --------------------------------------------------------------
# Bind address. Keep 127.0.0.1 — nginx (aaPanel) proxies to this and it
# keeps the app off the public internet directly.
# Set 0.0.0.0 only if you have no reverse proxy at all (NOT recommended).
RECRAFT_HOST=127.0.0.1

# Port nginx proxies to.
RECRAFT_PORT=7860

# Public URL prefix.
#   RECRAFT_ROOT_PATH=          -> app lives at   https://your-domain.com/
#   RECRAFT_ROOT_PATH=/recraft  -> app lives at   https://your-domain.com/recraft
# Must match the nginx `location` block exactly.
RECRAFT_ROOT_PATH=/recraft

# Hostnames allowed by the TrustedHost middleware. `*` accepts anything,
# which is fine behind your own domain. Use a comma-separated list to tighten:
# RECRAFT_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
RECRAFT_ALLOWED_HOSTS=*

# ---- Authentication (REQUIRED) -------------------------------------------
# This app stores live recraft.ai session cookies and spends your credits.
# Never serve it unauthenticated on a public IP.
# 1 = login required, 0 = no login (trusted LAN only).
RECRAFT_AUTH=1

RECRAFT_USER=recraft

# CHANGE THIS. Use a long random password, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Startup ABORTS if RECRAFT_AUTH=1 and this is empty.
RECRAFT_PASSWORD=change-me

# ---- Uploads / limits -----------------------------------------------------
# CSV batches and 4096x4096 JPEGs are large. Keep nginx's
# client_max_body_size at or above this value.
RECRAFT_MAX_UPLOAD=200

# ---- Optional -------------------------------------------------------------
# Server-side rendering of the Gradio UI. Disable if the page renders blank
# behind the proxy.
RECRAFT_SSR=1

# Keep Gradio's usage analytics off — this is a self-hosted tool holding real
# credentials. server.py sets this before importing Gradio; listed here so you
# can confirm it in one place.
GRADIO_ANALYTICS_ENABLED=False

# Any extra key/value pairs the app or a future plugin can read.
# RECRAFT_SECRET=replace-with-a-long-random-string
